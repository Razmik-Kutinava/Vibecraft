# Публичный URL сайта (без слэша в конце). Нужен для корректного sitemap и canonical.
# На Vercel: Settings → Environment Variables → Production. Допустимо с https:// или только домен (vibecraft.su).
# Если переменная пустая или битая, на Vercel подставится https://…из VERCEL_URL; иначе — дефолт из astro.config.
PUBLIC_SITE_URL=https://vibecraft.su

# Google Form: ссылка на форму (новая вкладка). Если не задана — используется значение по умолчанию в коде.
# PUBLIC_GOOGLE_FORM_URL=https://docs.google.com/forms/d/1gg8cxB3zzQXupNc6cKgpI_NZyQ6b1RM1PixU1o-27ZI/edit?usp=drive_web&ouid=116516540444923439498
