---
import type { Lang } from "@/i18n/landing";
import { getLandingMessages, telegramDirectUrl } from "@/i18n/landing";
import "@/styles/landing.css";

import LandingHeader from "@/components/landing/LandingHeader.astro";
import LandingHeroSection from "@/components/landing/LandingHeroSection.astro";
import LandingAudienceSection from "@/components/landing/LandingAudienceSection.astro";
import LandingWhyUsSection from "@/components/landing/LandingWhyUsSection.astro";
import LandingServicesSection from "@/components/landing/LandingServicesSection.astro";
import LandingPortfolioSection from "@/components/landing/LandingPortfolioSection.astro";
import LandingMidCtaSection from "@/components/landing/LandingMidCtaSection.astro";
import LandingBlogPreviewSection from "@/components/landing/LandingBlogPreviewSection.astro";
import LandingTermsSection from "@/components/landing/LandingTermsSection.astro";
import LandingContactSection from "@/components/landing/LandingContactSection.astro";
import LandingStickyCtaBar from "@/components/landing/LandingStickyCtaBar.astro";
import LandingFooterSection from "@/components/landing/LandingFooterSection.astro";
import LandingPageInteractions from "@/components/landing/LandingPageInteractions.astro";

import type { LandingBlogPreview } from "@/components/landing/types";

export type { LandingBlogPreview };

interface Props {
  lang: Lang;
  recentPosts: LandingBlogPreview[];
}

const { lang, recentPosts } = Astro.props;
const m = getLandingMessages(lang);
const base = `/${lang}`;
const menuOpenLabel = lang === "ru" ? "Открыть меню" : "Open menu";
const menuCloseLabel = lang === "ru" ? "Закрыть меню" : "Close menu";
const menuNavLabel = lang === "ru" ? "Основная навигация" : "Main navigation";

const googleFormUrl =
  import.meta.env.PUBLIC_GOOGLE_FORM_URL ?? "https://forms.gle/ydLZdiZhDUurb7hV8";
---

<LandingHeader
  lang={lang}
  m={m}
  base={base}
  menuOpenLabel={menuOpenLabel}
  menuCloseLabel={menuCloseLabel}
  menuNavLabel={menuNavLabel}
/>

<main>
  <LandingHeroSection m={m} base={base} telegramDirectUrl={telegramDirectUrl} />
  <LandingAudienceSection m={m} />
  <LandingWhyUsSection lang={lang} m={m} />
  <LandingServicesSection m={m} />
  <LandingPortfolioSection m={m} />
  <LandingMidCtaSection m={m} />
  <LandingBlogPreviewSection lang={lang} m={m} base={base} recentPosts={recentPosts} />
  <LandingTermsSection m={m} />
  <LandingContactSection m={m} telegramDirectUrl={telegramDirectUrl} googleFormUrl={googleFormUrl} />
</main>

<LandingStickyCtaBar m={m} />

<LandingFooterSection m={m} base={base} telegramDirectUrl={telegramDirectUrl} />

<LandingPageInteractions />
