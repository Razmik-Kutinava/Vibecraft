---
import type { LandingMessages } from "@/i18n/landing";
// 3D Hero (Three.js) отключён для LCP/JS — компоненты в @/components/hero/ сохранены для будущего включения.
// import HeroIsland from "@/components/hero/HeroIsland.tsx";

interface Props {
  m: LandingMessages;
  base: string;
  telegramDirectUrl: string;
}

const { m, base, telegramDirectUrl } = Astro.props;
---

<section class="hero">
  <div class="container">
    <div class="hero-layout hero-layout--no-canvas">
      <div class="hero-inner">
        <h1>{m.hero.h1}</h1>
        <p>{m.hero.lead}</p>
        <p class="hero-scenarios-label">{m.hero.scenariosKicker}</p>
        <ul class="hero-scenarios">
          <li>{m.hero.scenarioA}</li>
          <li>{m.hero.scenarioB}</li>
        </ul>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary">{m.hero.ctaPrimary}</a>
          <a href={telegramDirectUrl} class="hero-tg-link" target="_blank" rel="noopener noreferrer">{m.hero.ctaTelegram}</a>
        </div>
        <a href={`${base}/blog`} class="hero-trust-line">{m.hero.trustLine}</a>
      </div>
      {/*
      <div class="hero-visual hidden lg:block" aria-hidden="true">
        <HeroIsland client:visible />
      </div>
      */}
    </div>
  </div>
</section>
