<script is:inline>
  const navToggle = document.getElementById("nav-open");
  const burger = document.getElementById("nav-burger");
  const headerEl = document.querySelector("header.header");
  const labelOpen = headerEl?.dataset.menuOpenLabel ?? "Open menu";
  const labelClose = headerEl?.dataset.menuCloseLabel ?? "Close menu";

  function syncNavAria() {
    if (!navToggle || !burger) return;
    const open = navToggle.checked;
    burger.setAttribute("aria-expanded", open ? "true" : "false");
    burger.setAttribute("aria-label", open ? labelClose : labelOpen);
  }

  navToggle?.addEventListener("change", syncNavAria);
  syncNavAria();

  document.querySelectorAll(".nav-panel-inner a").forEach((link) => {
    link.addEventListener("click", () => {
      if (navToggle) navToggle.checked = false;
      syncNavAria();
    });
  });

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      const id = this.getAttribute("href");
      if (!id || id === "#") return;
      const target = document.querySelector(id);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  const whyMoreBtn = document.querySelector(".why-us-more-btn");
  if (whyMoreBtn) {
    whyMoreBtn.addEventListener("click", function () {
      document.querySelectorAll(".why-card--hidden-mob").forEach((card) => {
        card.classList.remove("why-card--hidden-mob");
      });
      this.closest(".why-us-more-wrap")?.remove();
    });
  }

  document.querySelectorAll(".card--service-header").forEach((btn) => {
    btn.addEventListener("click", function () {
      const card = this.closest(".card--service");
      if (!card) return;
      const expanded = card.classList.toggle("card--service-expanded");
      this.setAttribute("aria-expanded", expanded ? "true" : "false");
    });
  });

  const blogShowAllBtn = document.querySelector(".blog-show-all-btn");
  if (blogShowAllBtn) {
    blogShowAllBtn.addEventListener("click", function () {
      document.querySelectorAll(".blog-card--hidden-mob").forEach((card) => {
        card.classList.remove("blog-card--hidden-mob");
      });
      this.remove();
    });
  }
</script>
