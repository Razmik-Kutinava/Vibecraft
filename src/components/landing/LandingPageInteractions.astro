<script is:inline>
  const burger = document.getElementById("nav-burger");
  const scrim = document.getElementById("nav-scrim");
  const headerEl = document.querySelector("header.header");
  const labelOpen = headerEl?.dataset.menuOpenLabel ?? "Open menu";
  const labelClose = headerEl?.dataset.menuCloseLabel ?? "Close menu";

  function openNav() {
    headerEl?.classList.add("nav-is-open");
    document.documentElement.classList.add("nav-is-open");
    burger?.setAttribute("aria-expanded", "true");
    burger?.setAttribute("aria-label", labelClose);
  }

  function closeNav() {
    headerEl?.classList.remove("nav-is-open");
    document.documentElement.classList.remove("nav-is-open");
    burger?.setAttribute("aria-expanded", "false");
    burger?.setAttribute("aria-label", labelOpen);
  }

  burger?.addEventListener("click", () => {
    headerEl?.classList.contains("nav-is-open") ? closeNav() : openNav();
  });

  scrim?.addEventListener("click", closeNav);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && headerEl?.classList.contains("nav-is-open")) closeNav();
  });

  document.querySelectorAll(".nav-panel-inner a").forEach((link) => {
    link.addEventListener("click", closeNav);
  });

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      const id = this.getAttribute("href");
      if (!id || id === "#") return;
      const target = document.querySelector(id);
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  const whyMoreBtn = document.querySelector(".why-us-more-btn");
  if (whyMoreBtn) {
    whyMoreBtn.addEventListener("click", function () {
      document.querySelectorAll(".why-card--hidden-mob").forEach((card) => {
        card.classList.remove("why-card--hidden-mob");
      });
      this.closest(".why-us-more-wrap")?.remove();
    });
  }

  document.querySelectorAll(".card--service-btn").forEach((btn) => {
    btn.addEventListener("click", function () {
      const card = this.closest(".card--service");
      if (!card) return;
      const expanded = card.classList.toggle("card--service-expanded");
      this.setAttribute("aria-expanded", expanded ? "true" : "false");
    });
  });

  const blogShowAllBtn = document.querySelector(".blog-show-all-btn");
  if (blogShowAllBtn) {
    blogShowAllBtn.addEventListener("click", function () {
      document.querySelectorAll(".blog-card--hidden-mob").forEach((card) => {
        card.classList.remove("blog-card--hidden-mob");
      });
      this.remove();
    });
  }

  /* Email obfuscation: build mailto link via JS so raw email isn't indexed by crawlers */
  document.querySelectorAll("a.email-link[data-user][data-domain]").forEach((el) => {
    const addr = el.dataset.user + "@" + el.dataset.domain;
    el.href = "mailto:" + addr;
    el.textContent = addr;
  });
</script>
