---
import type { LandingMessages } from "@/i18n/landing";

interface Props {
  m: LandingMessages;
  base: string;
  telegramDirectUrl: string;
}

const { m, base, telegramDirectUrl } = Astro.props;
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-logo-row">
          <a class="footer-logo-block" href={base} aria-label="Vibecraft">
            <span class="logo-wordmark footer-wordmark" role="img" aria-hidden="true">
              <span class="logo-vibe">VIBE</span><span class="logo-craft">CRAFT</span>
            </span>
            <span class="footer-logo-sub">{m.footer.taglineSub}</span>
          </a>
        </div>
        <p class="footer-motto">{m.footer.motto}</p>
      </div>
      <div class="footer-links">
        <p class="footer-col-title">{m.footer.navCol}</p>
        <a href="#services">{m.nav.services}</a>
        <a href="#why-us">{m.nav.benefits}</a>
        <a href={`${base}/blog`}>{m.nav.blog}</a>
        <a href="#terms">{m.terms.shortNav}</a>
        <a href="#contact">{m.nav.contact}</a>
      </div>
      <div class="footer-links">
        <p class="footer-col-title">{m.footer.contactsCol}</p>
        <a href="#contact" class="email-link" data-user="hello" data-domain="vibecraft.su" aria-label="Email">&#8203;</a>
        <a href={telegramDirectUrl} target="_blank" rel="noopener noreferrer">{m.footer.tgDirect}</a>
      </div>
    </div>
    <div class="copyright">© {new Date().getFullYear()} Vibecraft. {m.footer.rights}</div>
  </div>
</footer>
